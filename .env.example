# Deployed Cloudflare Worker URL. If unset, the app runs local-only
# (localStorage) and shows the "Đồng bộ đang tắt — kiểm tra cấu hình" notice.
VITE_WORKER_URL=
# Must match the Worker's WRITE_TOKEN secret.
VITE_WRITE_TOKEN=
# BASE_PATH is deliberately NOT set here. It is a build-time literal supplied by
# .github/workflows/deploy-pages.yml (BASE_PATH=/skincare-routine-webapp/) so the
# Pages project path resolves; vite.config.ts falls back to "/" for local dev,
# which is what you want locally. Setting it in .env would break `npm run dev`.
